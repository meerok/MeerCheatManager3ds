    "storeContent": [
        {
            "info": {
                "title": "McM3 (Meer Cheat Manager 3ds)",
                "author": "Meer",
                "version": "v0.2.4",
                "category": [
                    "utility"
                ],
                "console": [
                    "3DS"
                ],
                "description": "In-game cheat manager plugin for Luma3DS. Detects your game, has built-in cheats for 644 games and lets you set exact amounts. Open it in game with R + Down + Select.",
                "license": "gpl-3.0",
                "last_updated": "2026-11-23 at 17:14 (UTC)",
                "releasenotes": "Fixes the crash right after pressing **R + Down + Select** in v0.2.3 (prefetch abort, PC 06386668).\n\n**What was wrong:** at 2 MiB, CTRPF (the framework McM3 is built on) kept 1 MB of memory reserved for a cheat-search tool that McM3 doesn't use, on top of its 676 KB of screen buffers. That left only about 100 KB for everything else, so opening the menu ran out of memory and crashed.\n\n**Fix:** McM3 now shrinks that unused reserve to 128 KB at startup, freeing about 900 KB. It still uses 2 MiB, so Old 3DS stays safe.\n\n**Install:** put `McM3.3gx` in `sd:/luma/plugins/` and rename it to `default.3gx`, or update through Universal-Updater."
            },
            "McM3.3gx (all games)": [
                {
                    "type": "mkdir",
                    "directory": "sdmc:/luma/plugins/"
                },
                {
                    "type": "downloadRelease",
                    "repo": "meerok/MeerCheatManager3ds",
                    "file": "McM3.3gx",
                    "output": "sdmc:/luma/plugins/default.3gx",
                    "includePrereleases": false,
                    "message": "Downloading McM3..."
                },
                {
                    "type": "timeMsg",
                    "seconds": 6,
                    "message": "McM3 installed to /luma/plugins/default.3gx.\n\nTurn on Plugin Loader in Rosalina (L + Down + Select),\nstart a game, then press R + Down + Select."
                }
            ]
        }
    ]
}
